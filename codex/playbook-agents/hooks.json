{
  "hooks": {
    "SessionStart": [{
      "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/session-start.py\""}]
    }],
    "PreToolUse": [{
      "matcher": "^Bash$",
      "hooks": [{"type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/review-before-commit.sh\""}]
    }],
    "SubagentStop": [{
      "matcher": "^review$",
      "hooks": [{"type": "command", "command": "sh \"${PLUGIN_ROOT}/hooks/review-ran.sh\" --mark-only"}]
    }]
  }
}
