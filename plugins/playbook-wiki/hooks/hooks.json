{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/contract.md\""
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/doctor/scripts/wiki-format.sh\" hook"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/contract-for-subagent.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/merge-step-hook.sh\""
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/commit-check-hook.sh\""
          }
        ]
      }
    ]
  }
}
